# Copy to .env.local (git-ignored) for `pnpm dev`. On Vercel, set the same names as project
# environment variables instead. None of these reach the browser: never prefix them with VITE_.

# Your permanent Decart key (dct_…). Only the server reads it; the browser gets 60-second client tokens.
DECART_API_KEY=

# Shared code testers type once on the page. Required on a hosted deployment (Vercel), optional locally.
LIVE_TRYON_ACCESS_CODE=

# Cost guards (defaults shown). Decart bills $0.02 per generated second, $0.04 in fast mode.
# Longest single session, enforced by Decart and by the page
LIVE_TRYON_MAX_SESSION_SECONDS=120
# Total session time per UTC day that tokens may be minted for; 0 turns the daily cap off
LIVE_TRYON_DAILY_MINUTES=20
# Live sessions on the Decart account at once (Decart's own counter, shared by every key)
LIVE_TRYON_MAX_CONCURRENT=2

# Optional: other web origins allowed to ask for tokens, comma-separated (default: the page's own origin)
LIVE_TRYON_ALLOWED_ORIGINS=

# Optional: Upstash Redis (Vercel Marketplace) makes the daily cap exact across serverless instances.
# Without it the hosted cap is counted per instance (best effort).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
