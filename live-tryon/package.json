{
  "name": "vto3d-live-tryon",
  "private": true,
  "version": "0.0.0",
  "description": "Live try-on with Decart's Lucy VTON 3.6: token back end, test page and tests. Self-contained: the VTO3D app does not import it.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite",
    "dev:fake": "node scripts/dev-fake.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "catalog": "node scripts/sync-catalog.ts",
    "measure": "playwright test --config playwright.measure.config.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm e2e",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "dependencies": {
    "@decartai/sdk": "0.2.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
